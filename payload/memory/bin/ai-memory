#!/usr/bin/env python3
"""Private memory shared by Claude Code and Codex: ~/ai-memory, plus one folder per project.

  ai-memory link [NAME] [--dir DIR] [--about TEXT] [--nested]
      Give a folder (default: the current one) its own memory in ~/ai-memory/projects/NAME.
      Writes the folder's .ai-memory marker, points Claude's auto-memory there in
      .claude/settings.local.json, moves in the notes Claude kept for the folder under
      ~/.claude/projects, keeps both files out of git, and lists the project in
      ~/ai-memory/MEMORY.md. Safe to run again, e.g. after renaming or moving the folder.
  ai-memory where [DIR]   print the project memory that DIR (or a folder above it) uses
  ai-memory status        check every project's folder and link
  ai-memory snapshot      commit changes in ~/ai-memory to its local git history (a timer runs it)
"""
import argparse
import contextlib
from datetime import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

HOME = Path.home()
ROOT = HOME / 'ai-memory'
PROJECTS = ROOT / 'projects'
INDEX = ROOT / 'MEMORY.md'
MARKER = '.ai-memory'
SETTINGS = '.claude/settings.local.json'
CLAUDE_PROJECTS = HOME / '.claude/projects'
# Outside ~/ai-memory so the snapshot timer never commits it.
LOCK = HOME / '.local/state/ai-memory/index.lock'
# Global git ignore patterns; ** so a project folder deeper inside a repository is covered too.
IGNORED = ('.ai-memory', '**/.claude/settings.local.json')
HEADING = '## Projects'
INTRO = 'Private memory for one folder each, in `projects/<name>/`. `ai-memory status` checks the links.'
NAME = re.compile(r'[a-z0-9][a-z0-9-]*')
LINE = re.compile(r'- \[(?P<name>[a-z0-9][a-z0-9-]*)\]\(projects/(?P=name)/MEMORY\.md\) — `(?P<folder>[^`]+)`(?P<rest>.*)')


def die(message):
    raise SystemExit('ai-memory: ' + message)


def tilde(path):
    path = Path(path)
    return '~/' + str(path.relative_to(HOME)) if path.is_relative_to(HOME) and path != HOME else str(path)


def write(path, text):
    """Replace a file in one step, so the other agent never reads half of it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    handle, temp = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name + '.')
    with os.fdopen(handle, 'w') as file:
        file.write(text)
    os.chmod(temp, mode)
    os.replace(temp, path)


def git(folder, *args, check=False):
    result = subprocess.run(['git', '-C', str(folder), *args], capture_output=True, text=True)
    if check and result.returncode:
        die('git ' + ' '.join(args) + ' failed: ' + (result.stderr.strip() or result.stdout.strip()))
    return result


def slug(name):
    name = re.sub(r'(?<=[a-z0-9])(?=[A-Z])', '-', name)
    return re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')


def marked(folder):
    """The project named by folder's .ai-memory marker, or None."""
    try:
        lines = (folder / MARKER).read_text().splitlines()
    except (FileNotFoundError, NotADirectoryError, IsADirectoryError, PermissionError):
        return None
    name = Path(os.path.expanduser(next((line.strip() for line in lines if line.strip()), ''))).name
    return name if NAME.fullmatch(name) else None


def find(start):
    """The nearest folder at or above start that has a marker, and its project name."""
    for folder in (start, *start.parents):
        name = marked(folder)
        if name:
            return folder, name
    return None, None


@contextlib.contextmanager
def index_lock():
    """Hold the global index while it is read, changed and written; other ai-memory runs wait."""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def listed():
    """Projects in the global index: name -> (folder as written, rest of the line)."""
    lines = INDEX.read_text().splitlines() if INDEX.exists() else []
    return {m['name']: (m['folder'], m['rest']) for m in map(LINE.fullmatch, lines) if m}


def list_project(name, folder, about=None):
    """Add or update the project's line under ## Projects in the global index; True if it changed.

    Call it with index_lock() held, from before the index is read until it is written.
    """
    lines = INDEX.read_text().splitlines() if INDEX.exists() else []
    old = next((i for i, line in enumerate(lines) if (m := LINE.fullmatch(line)) and m['name'] == name), None)
    rest = ' · ' + about if about else (LINE.fullmatch(lines[old])['rest'] if old is not None else '')
    entry = f'- [{name}](projects/{name}/MEMORY.md) — `{tilde(folder)}`{rest}'
    if old is not None:
        if lines[old] == entry:
            return False
        lines[old] = entry
    else:
        if HEADING not in lines:
            while lines and not lines[-1].strip():
                lines.pop()
            lines += ['', HEADING, INTRO]
        start = lines.index(HEADING) + 1
        end = next((i for i in range(start, len(lines)) if lines[i].startswith('#')), len(lines))
        later = [i for i in range(start, end) if (m := LINE.fullmatch(lines[i])) and m['name'] > name]
        position = later[0] if later else end
        while not later and position > start + 1 and not lines[position - 1].strip():
            position -= 1
        lines.insert(position, entry)
    write(INDEX, '\n'.join(lines) + '\n')
    return True


def claude_default(folder):
    """Where Claude Code keeps a folder's auto-memory unless told otherwise."""
    return CLAUDE_PROJECTS / re.sub(r'[^A-Za-z0-9]', '-', str(folder)) / 'memory'


def move_in(folder, target):
    """Move the notes Claude kept for this folder under ~/.claude/projects into the project memory."""
    source = claude_default(folder)
    if not source.is_dir():
        return 0
    notes = [p for p in sorted(source.iterdir()) if p.is_file() and p.name != 'MEMORY.md']
    for path in notes:
        if (target / path.name).exists() and (target / path.name).read_bytes() != path.read_bytes():
            die(f'{tilde(target / path.name)} already exists and differs from {tilde(path)}. Merge them by hand.')
    for path in notes:
        if (target / path.name).exists():
            path.unlink()
        else:
            shutil.move(path, target / path.name)
    old_index = source / 'MEMORY.md'
    if old_index.exists():
        index = target / 'MEMORY.md'
        have = [line for line in index.read_text().splitlines() if line.strip()] if index.exists() else []
        extra = [line for line in old_index.read_text().splitlines() if line.strip() and line not in have]
        if extra:
            write(index, '\n'.join(have + extra) + '\n')
        old_index.unlink()
    try:
        source.rmdir()
    except OSError:
        print(f'  left behind in {tilde(source)}: ' + ', '.join(p.name for p in source.iterdir()))
    return len(notes)


def claude_settings(folder):
    """The folder's local Claude settings, checked before anything is changed."""
    path = folder / SETTINGS
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text() or '{}')
    except json.JSONDecodeError as error:
        die(f'{tilde(path)} is not valid JSON ({error}). Fix it, then run this again.')
    if not isinstance(data, dict):
        die(f'{tilde(path)} does not hold a JSON object.')
    return data


def point_claude(folder, name, data):
    """Point Claude's auto-memory for this folder at the project memory; returns the old setting."""
    wanted = f'~/ai-memory/projects/{name}'
    old = data.get('autoMemoryDirectory')
    if old != wanted:
        write(folder / SETTINGS, json.dumps({**data, 'autoMemoryDirectory': wanted}, indent=2) + '\n')
    return old


def ignore(folder):
    """Keep the marker and Claude's local settings out of git, machine-wide and in this repository."""
    configured = subprocess.run(['git', 'config', '--global', '--get', 'core.excludesfile'],
                                capture_output=True, text=True).stdout.strip()
    path = (Path(os.path.expanduser(configured)) if configured else
            Path(os.environ.get('XDG_CONFIG_HOME') or HOME / '.config') / 'git/ignore')
    lines = path.read_text().splitlines() if path.exists() else []
    if missing := [pattern for pattern in IGNORED if pattern not in lines]:
        write(path, '\n'.join(lines + missing) + '\n')
    if git(folder, 'rev-parse', '--show-toplevel').returncode:
        return []
    warnings = []
    for name in (MARKER, SETTINGS):
        if not git(folder, 'ls-files', '--error-unmatch', name).returncode:
            warnings.append(f'{name} is already committed in this repository; take it out of git (git rm --cached {name}).')
            continue
        if not git(folder, 'check-ignore', '-q', '--no-index', name).returncode:
            continue
        # A repository-level excludesFile setting hides the global list; exclude it in this repository too.
        exclude = Path(git(folder, 'rev-parse', '--path-format=absolute', '--git-path', 'info/exclude', check=True).stdout.strip())
        top = Path(git(folder, 'rev-parse', '--show-toplevel', check=True).stdout.strip())
        text = exclude.read_text() if exclude.exists() else ''
        write(exclude, text + ('\n' if text and not text.endswith('\n') else '') + '/' + str((folder / name).relative_to(top)) + '\n')
        if git(folder, 'check-ignore', '-q', '--no-index', name).returncode:
            warnings.append(f"{name} is not ignored here (this repository's .gitignore un-ignores it); never commit it.")
    return warnings


def link(args):
    folder = Path(args.dir or os.getcwd()).expanduser().resolve()
    if not folder.is_dir():
        die(f'{args.dir} is not a folder.')
    if HOME.is_relative_to(folder) or folder.is_relative_to(ROOT):
        die(f'{tilde(folder)} cannot have a project memory: memory saved there is global.')
    if args.name and not NAME.fullmatch(args.name):
        die(f'"{args.name}" is not a usable name: use lower-case words joined by hyphens.')
    # Everything that reads the markers or the index happens under the lock: two links at once
    # would otherwise both decide from the same old state, and the second would undo the first.
    with index_lock():
        current = marked(folder)
        name = args.name or current or slug(folder.name)
        if not NAME.fullmatch(name):
            die(f'"{name}" is not a usable name: use lower-case words joined by hyphens.')
        if current and current != name:
            die(f'{tilde(folder)} already uses the project memory "{current}".')
        if not current and not args.nested:
            above, other = find(folder.parent)
            if above:
                die(f'{tilde(above)} already gives this folder its memory ("{other}"). Use that one, '
                    'or pass --nested for a separate memory here.')
        settings = claude_settings(folder)
        owner = listed().get(name)
        if owner and not current:
            elsewhere = Path(os.path.expanduser(owner[0]))
            if elsewhere != folder and marked(elsewhere) == name:
                die(f'"{name}" already belongs to {owner[0]}. Choose another name.')
        target = PROJECTS / name
        target.mkdir(parents=True, exist_ok=True)
        (target / 'MEMORY.md').touch()
        moved = move_in(folder, target)
        if current != name:
            write(folder / MARKER, f'~/ai-memory/projects/{name}\n')
        old = point_claude(folder, name, settings)
        warnings = ignore(folder)
        changed = list_project(name, folder, args.about)
    print(f'Project memory: {tilde(target)}')
    print(f'  folder: {tilde(folder)} ({MARKER} marker' + (', new)' if current != name else ')'))
    if moved:
        print(f'  moved in {moved} note' + ('s' if moved != 1 else '') + ' Claude kept for this folder')
    if old != f'~/ai-memory/projects/{name}':
        print(f'  Claude: {SETTINGS} sets autoMemoryDirectory' + (f' (was {old})' if old else '')
              + '; new sessions use it after a one-time trust question')
    if changed:
        print(f'  listed under {HEADING} in ~/ai-memory/MEMORY.md')
    for warning in warnings:
        print('  warning: ' + warning)


def where(args):
    _, name = find(Path(args.dir or os.getcwd()).expanduser().resolve())
    if not name:
        return 1
    print(PROJECTS / name)
    return 0


def status(args):
    projects = listed()
    names = sorted(set(projects) | ({p.name for p in PROJECTS.iterdir() if p.is_dir()} if PROJECTS.is_dir() else set()))
    problems = 0
    for name in names:
        notes = len([p for p in (PROJECTS / name).glob('*.md') if p.name != 'MEMORY.md'])
        folder = projects.get(name, (None,))[0]
        path = Path(os.path.expanduser(folder)) if folder else None
        if not folder:
            state = f'not listed in ~/ai-memory/MEMORY.md: run ai-memory link {name} in its folder'
        elif not path.is_dir():
            state = f'folder not found (renamed or moved? run ai-memory link {name} in its new place)'
        elif marked(path) != name:
            state = f'the folder has no {MARKER} marker: run ai-memory link {name} there'
        else:
            try:
                pointed = json.loads((path / SETTINGS).read_text()).get('autoMemoryDirectory')
            except (OSError, ValueError, AttributeError):
                pointed = None
            state = 'ok' if pointed == f'~/ai-memory/projects/{name}' else f'Claude is not pointed at it: run ai-memory link {name} there'
        problems += state != 'ok'
        print(f'{name}  ({notes} note' + ('s' if notes != 1 else '') + f')  {folder or "-"}  {state}')
    for memory in sorted(CLAUDE_PROJECTS.glob('*/memory')):
        notes = [p for p in memory.iterdir() if p.is_file() and p.name != 'MEMORY.md']
        if notes:
            print(f'not linked yet: {tilde(memory)} ({len(notes)} Claude note' + ('s' if len(notes) != 1 else '') + ')')
    if not names:
        print('No project memories yet.')
    return 1 if problems else 0


def snapshot(args):
    """Commit whatever changed in ~/ai-memory, so a deleted or overwritten note can be restored."""
    if not ROOT.is_dir():
        return 0
    if not (ROOT / '.git').exists():
        git(ROOT, 'init', '-q', '-b', 'main', check=True)
    if (ROOT / '.git/index.lock').exists():
        return 0  # Another git command is busy here; the next run picks the changes up.
    git(ROOT, 'add', '-A', check=True)
    changes = git(ROOT, 'diff', '--cached', '--name-status', check=True).stdout.strip()
    if not changes:
        return 0
    identity = [] if git(ROOT, 'config', 'user.email').stdout.strip() else \
        ['-c', 'user.name=ai-memory', '-c', 'user.email=ai-memory@localhost']
    message = 'Snapshot ' + datetime.now().strftime('%Y-%m-%d %H:%M') + '\n\n' + changes + '\n'
    result = subprocess.run(['git', '-C', str(ROOT), *identity, '-c', 'commit.gpgsign=false',
                             'commit', '-q', '--no-verify', '-F', '-'], input=message, capture_output=True, text=True)
    if result.returncode:
        die('git commit failed: ' + (result.stderr.strip() or result.stdout.strip()))
    if args.verbose:
        print(changes)
    return 0


def main():
    parser = argparse.ArgumentParser(prog='ai-memory', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True)
    command = commands.add_parser('link', help='give a folder its own project memory, or repair its link')
    command.add_argument('name', nargs='?', help='project name (default: the folder name, in kebab-case)')
    command.add_argument('--dir', help='the project folder (default: the current folder)')
    command.add_argument('--about', help='a few words for the project line in ~/ai-memory/MEMORY.md')
    command.add_argument('--nested', action='store_true', help='allow a separate memory inside a linked folder')
    command.set_defaults(run=link)
    command = commands.add_parser('where', help='print the project memory a folder uses')
    command.add_argument('dir', nargs='?')
    command.set_defaults(run=where)
    commands.add_parser('status', help='check every project link').set_defaults(run=status)
    command = commands.add_parser('snapshot', help='commit changes to the local git history')
    command.add_argument('-v', '--verbose', action='store_true')
    command.set_defaults(run=snapshot)
    args = parser.parse_args()
    sys.exit(args.run(args) or 0)


if __name__ == '__main__':
    main()
