#!/usr/bin/env python3
"""Open a right-clicked file reference, preserving its line and column."""
from pathlib import Path
import sys
sys.path.insert(0, str(Path.home() / '.local/share/workspace'))
from workspace import open_file, pane, parse_reference, tmux
if __name__ == '__main__':
    target = sys.argv[1]
    folder = pane(target)['cwd']
    word = tmux('display-message', '-p', '-t', target, '#{@clicked}').stdout.strip()
    path, line, column = parse_reference(word, folder)
    if path.exists():
        open_file(path, line, column)
    else:
        tmux('display-message', '-t', target, 'Not found: ' + str(path))
