{
  "theme": "custom:amoled",
  "tui": "fullscreen",
  "copyOnSelect": true,
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold",
    "autoSubmit": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/workspace-control hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
