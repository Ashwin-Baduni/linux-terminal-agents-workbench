[Desktop Entry]
Type=Application
Name=Ghostty (open here)
Comment=Used by "Open in Terminal" and Ctrl+Alt+T: opens a Ghostty window in the requested folder
Exec=@GHOSTTY_BIN@ +new-window
TryExec=@GHOSTTY_BIN@
Icon=com.mitchellh.ghostty
Terminal=false
NoDisplay=true
Categories=System;TerminalEmulator;
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
